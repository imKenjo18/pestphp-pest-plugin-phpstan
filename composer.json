{
    "name": "pestphp/pest-plugin-phpstan",
    "description": "PHPStan plugin for Pest",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "phpstan"
    ],
    "type": "phpstan-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Punyapal Shah",
            "email": "mrpunyapal@gmail.com"
        },
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "pestphp/pest": "^5.0.0",
        "phpstan/phpstan": "^2.2.5"
    },
    "require-dev": {
        "laravel/pao": "^1.1.2",
        "laravel/pint": "^1.29.3",
        "pestphp/pest-plugin-rector": "^5.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.5.7"
    },
    "conflict": {
        "pestphp/pest": "<5.0.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\PHPStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform-check": false
    },
    "scripts": {
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "rector --dry-run",
            "pint --test --parallel"
        ],
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
